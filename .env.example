# ─── MOOD Coffee Shop & Bakery ── copy this file to `.env` and fill in your values.
# (.env is loaded automatically by npm start — Node's built-in --env-file support)

PORT=3000

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=moodcoffee
# Set to 1 when using a cloud MySQL (TiDB Cloud / Aiven) that requires TLS
DB_SSL=0

# Set to 1 when the site is behind HTTPS (Nginx/Caddy) so login cookies get the Secure flag
COOKIE_SECURE=0

# Public base URL of the live site — used to build the return link after payment.
# Example: https://moodcoffee.rw
BASE_URL=http://localhost:3000

# ─── Flutterwave online payments (v4) ─────────────────────────
# Get keys at https://dashboard.flutterwave.com → Settings → API:
#   Client ID, Client Secret, Encryption Key.
# FLW_ENV=test -> sandbox   (https://developersandbox-api.flutterwave.com)
# FLW_ENV=live -> production (https://f4bexperience.flutterwave.com)
FLW_CLIENT_ID=
FLW_CLIENT_SECRET=
FLW_ENCRYPTION_KEY=
FLW_ENV=test
# Set a Webhook Secret Hash in Flutterwave → Settings → Webhooks (Test webhooks tab)
# and paste it here so /api/pay/webhook can verify the HMAC signature.
FLW_WEBHOOK_SECRET=

# ─── Optional SMTP defaults (can also be set in Admin → Settings → Email) ──
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM=MOOD Coffee <you@gmail.com>

# ─── Google sign-in (optional — enables "Continue with Google") ─────────
# Get an OAuth client at https://console.cloud.google.com → APIs & Services →
# Credentials → Create Credentials → OAuth client ID (Web application).
# Add "<your site>/api/auth/google/callback" to the Authorized redirect URIs.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
